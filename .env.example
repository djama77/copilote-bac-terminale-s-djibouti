# Copilote Bac — variables serveur Vercel
# Ne jamais mettre une vraie clé API dans GitHub.

# Compatible avec une API de chat au format OpenAI.
TUTOR_API_URL=https://api.groq.com/openai/v1/chat/completions

# À définir uniquement dans Vercel > Project > Settings > Environment Variables
TUTOR_API_KEY=

# Choisir un modèle disponible chez votre fournisseur.
# Pour corriger une photo, le modèle choisi doit accepter les images.
TUTOR_MODEL=
